{
  "name": "@pi-simple-web/web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "build:cloudflare": "nuxt generate && node scripts/build-cloudflare.ts",
    "deploy": "pnpm build:cloudflare && cf deploy --prebuilt",
    "deploy:check": "pnpm build:cloudflare && cf deploy --prebuilt --dry-run",
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "preview": "nuxt preview --host 127.0.0.1 --port 3000",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@comark/nuxt": "^0.7.0",
    "@iconify-json/lucide": "^1.2.139",
    "@nuxt/ui": "^4.11.3",
    "@pi-simple-web/shared": "workspace:*",
    "@pinia/colada": "^1.4.7",
    "@pinia/colada-nuxt": "^1.2.0",
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.3",
    "@cloudflare/config": "0.27.0",
    "cf": "1.0.0-beta.18",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.12"
  }
}
