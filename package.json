{
  "name": "pi-simple-web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.28.3+sha512.d49760a13b1755948775a5d4cb1bc4ba871ff2dc941adf851630d044ed722f9b5be8be57bef93166098c80c706bd612c282d05526dd1d0ae660188c086820f35",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "build:web": "pnpm --filter @pi-simple-web/web build",
    "build:api": "pnpm --filter @pi-simple-web/api build",
    "generate": "pnpm --filter @pi-simple-web/web generate",
    "preview": "pnpm --parallel --filter './apps/*' preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "pnpm --filter './apps/*' typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@comark/nuxt": "^0.7.0",
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@pi-simple-web/shared": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.12"
  }
}
